# Krushi Mitra AI Backend Configuration
PROJECT_NAME="Krushi Mitra AI Backend"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000

# Google Gemini Vision API Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
ACTIVE_VISION_PROVIDER="gemini"  # "gemini" | "baseline" | "yolo"

# YOLO Integration (Optional custom fine-tuned weights)
YOLO_WEIGHTS_PATH="models/yolo_rice_pests_v1.pt"

# Supabase Managed Cloud Configuration (Optional for local development)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="crop-scans"
